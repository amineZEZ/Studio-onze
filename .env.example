# À mettre dans Vercel → Settings → Environment Variables (jamais sur GitHub).
# Formulaire de devis (Resend) :
RESEND_API_KEY=
DEVIS_TO=
# Facultatif, quand ton domaine sera vérifié dans Resend :
DEVIS_FROM=
# Adresse officielle du site, quand le nom de domaine sera branché :
NEXT_PUBLIC_SITE_URL=
# Mentions légales (obligatoires) :
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_SIRET=
# Google Search Console (facultatif) :
GOOGLE_SITE_VERIFICATION=
